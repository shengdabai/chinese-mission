# AI API Configuration
# Supports: OpenAI-compatible APIs (OpenAI, Claude via proxy, DeepSeek, etc.)

AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Set to "true" to force rule-based engine (no AI calls)
USE_RULE_ENGINE=false

# Shared quota store (production). Create a Redis database in the Vercel Marketplace
# (Upstash) or any Upstash Redis; the Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN
# are accepted too. Without these, request budgets are counted per serverless instance
# only and /api/health reports "quotaStore": "memory".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
